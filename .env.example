# MongoDB connection string (e.g. from MongoDB Atlas)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/streamflow?retryWrites=true&w=majority

# JWT secret key for session/auth token signing
JWT_SECRET=your_jwt_secret_key_here_at_least_32_characters

# Base URL (optional)
NEXT_PUBLIC_APP_URL=http://localhost:3000
